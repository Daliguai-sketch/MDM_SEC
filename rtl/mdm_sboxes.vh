// Constant GF(2) matrix, not a 245-deep iterative multiply.
function automatic [31:0] snow_mulalpha(input [7:0] x);
  begin
    snow_mulalpha = 32'b0;
    if (x[0]) snow_mulalpha = snow_mulalpha ^ 32'he19fcf13;
    if (x[1]) snow_mulalpha = snow_mulalpha ^ 32'h6b973726;
    if (x[2]) snow_mulalpha = snow_mulalpha ^ 32'hd6876e4c;
    if (x[3]) snow_mulalpha = snow_mulalpha ^ 32'h05a7dc98;
    if (x[4]) snow_mulalpha = snow_mulalpha ^ 32'h0ae71199;
    if (x[5]) snow_mulalpha = snow_mulalpha ^ 32'h1467229b;
    if (x[6]) snow_mulalpha = snow_mulalpha ^ 32'h28ce449f;
    if (x[7]) snow_mulalpha = snow_mulalpha ^ 32'h50358897;
  end
endfunction

// Constant GF(2) matrix, not a 245-deep iterative multiply.
function automatic [31:0] snow_divalpha(input [7:0] x);
  begin
    snow_divalpha = 32'b0;
    if (x[0]) snow_divalpha = snow_divalpha ^ 32'h180f40cd;
    if (x[1]) snow_divalpha = snow_divalpha ^ 32'h301e8033;
    if (x[2]) snow_divalpha = snow_divalpha ^ 32'h603ca966;
    if (x[3]) snow_divalpha = snow_divalpha ^ 32'hc078fbcc;
    if (x[4]) snow_divalpha = snow_divalpha ^ 32'h29f05f31;
    if (x[5]) snow_divalpha = snow_divalpha ^ 32'h5249be62;
    if (x[6]) snow_divalpha = snow_divalpha ^ 32'ha492d5c4;
    if (x[7]) snow_divalpha = snow_divalpha ^ 32'he18d0321;
  end
endfunction
